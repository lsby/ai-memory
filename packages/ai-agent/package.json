{
  "name": "@lsby/ai-agent",
  "version": "0.1.0",
  "description": "A lightweight TypeScript agent library for OpenAI-compatible models.",
  "keywords": [
    "ai",
    "agent",
    "openai",
    "typescript"
  ],
  "homepage": "https://github.com/lsby/ai-memory#readme",
  "bugs": {
    "url": "https://github.com/lsby/ai-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsby/ai-memory.git",
    "directory": "packages/ai-agent"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/esm/internal.d.ts",
        "default": "./dist/esm/internal.js"
      },
      "require": {
        "types": "./dist/cjs/internal.d.cts",
        "default": "./dist/cjs/internal.cjs"
      }
    }
  },
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:all": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsup src/index.ts src/internal.ts --platform node --format cjs --clean --dts -d dist/cjs",
    "build:esm": "tsup src/index.ts src/internal.ts --platform node --format esm --clean --dts -d dist/esm",
    "check:all": "pnpm run check:format && pnpm run check:lint && pnpm run check:type",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:type": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run verify:release",
    "publish:npm": "pnpm publish --access public",
    "release": "pnpm run verify:release && bumpp --git-check --commit \"chore(release): @lsby/ai-agent v%s\" --tag \"@lsby/ai-agent@%s\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "verify:release": "pnpm run check:all && pnpm run test:coverage && pnpm run build:all",
    "version:bump": "bumpp --no-commit --no-tag --no-push"
  },
  "dependencies": {
    "jsonrepair": "^3.13.1",
    "openai": "^4.86.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "~3.24.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@lsby/eslint-config": "^0.5.6",
    "@lsby/eslint-plugin": "^0.2.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^3.0.9",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "to-fast-properties": "^2.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
