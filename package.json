{
  "name": "@lsby/ai-memory",
  "version": "0.2.0",
  "description": "A PGlite-backed TypeScript library for OpenAI-compatible agents with persistent, layered memory.",
  "keywords": [
    "ai",
    "agent",
    "memory",
    "openai",
    "pglite",
    "typescript"
  ],
  "homepage": "https://github.com/lsby/ai-memory#readme",
  "bugs": {
    "url": "https://github.com/lsby/ai-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lsby/ai-memory.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:all": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsup src/index.ts --platform node --format cjs --clean --dts -d dist/cjs",
    "build:esm": "tsup src/index.ts --platform node --format esm --clean --dts -d dist/esm",
    "check:all": "pnpm run check:format && pnpm run check:lint && pnpm run check:type",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:type": "tsc --noEmit",
    "check:type:watch": "tsc --noEmit -w",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "pnpm run verify:release",
    "public:npm": "pnpm publish --access public",
    "release": "pnpm run verify:release && bumpp --no-commit --no-tag --no-push && tsx scripts/release/release.ts",
    "setup:rename": "tsx scripts/setup/rename-project.ts",
    "test": "vitest run",
    "test:base": "pnpm run test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "open-cli ./coverage/index.html",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "verify:release": "pnpm run check:all && pnpm run test:coverage && pnpm run build:all"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-pgvector": "^0.0.6",
    "@huggingface/transformers": "^4.2.0",
    "ajv": "^8.17.1",
    "d3": "^7.9.0",
    "jsonrepair": "^3.13.1",
    "kysely": "^0.29.2",
    "openai": "^4.86.1",
    "proper-lockfile": "^4.1.2",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@lsby/eslint-config": "^0.5.6",
    "@lsby/eslint-plugin": "^0.2.1",
    "@types/d3": "^7.4.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.13.14",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^3.0.9",
    "bumpp": "^10.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-sort-class-members": "^1.21.0",
    "husky": "^9.1.7",
    "inquirer": "^12.9.4",
    "lint-staged": "^15.5.0",
    "open-cli": "^8.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^2.5.20",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
