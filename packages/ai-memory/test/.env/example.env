# ==========================================
# 示例配置模板：复制并命名为 <name>.env 即可使用
# 使用方式: pnpm run benchmark:locomo -- --config <name>
# ==========================================

# 1. 被测智能体配置 (Target Agent Model)
AI_BASE_URL=https://api.deepseek.com/v1
AI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=deepseek-chat
USE_NATIVE_TOOL_CALLS=1

# 2. 裁判模型配置 (LLM-as-a-Judge)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=local
JUDGE_MODEL=gpt-oss-20b

# 3. 评测范围（可选）
# LOCOMO_SAMPLE_INDEX=0
# LOCOMO_MAX_SESSIONS=3
# LOCOMO_MAX_QA=10
